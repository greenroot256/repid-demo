# npm's peer-dependency resolution crashes on this dependency tree.
#
# Reproduced on npm 10.9.2: installing from scratch fails with
#     Cannot read properties of null (reading 'edgesOut')
# while the same install succeeds with the legacy algorithm. The failure is in
# npm's own tree building, not in this project or in @repid/sdk.
#
# legacy-peer-deps=true selects that algorithm. It lives in a file rather than on
# the command line so that `npm install`, `npm ci` and the deployment build all
# behave the same way, including on Render, which runs `npm ci`.
#
# This is not cosmetic. Without it a fresh clone cannot be installed at all, so
# the bug is fixed rather than documented around.
#
# Re-test before assuming it is still needed: if a later npm release fixes the
# resolution, delete this file and this comment rather than leaving it behind as
# folklore.
legacy-peer-deps=true
